## The 14 safe stills (one per sub-tool)

For absolute emergencies, capture the LAST frame of each MP4 as PNG. If even MP4 playback fails (rare but possible — disk read error, codec issue), the safe still displays instantly.

```bash
# Bash script to extract last frame of each MP4
for f in public/fallback/*.mp4; do
  name=$(basename "$f" .mp4)
  ffmpeg -sseof -3 -i "$f" -update 1 -q:v 1 "public/safe/${name}-still.png"
done
```

## The 7 kill switches

```tsx
// src/components/stage/KillSwitches.tsx
"use client";
import { useEffect } from "react";
import { stageActor } from "@/lib/machine";
import { ambientBed, sfx } from "@/lib/audio";

export function KillSwitches() {
  useEffect(() => {
    const handler = (e: KeyboardEvent) => {
      // Escape — back one level
      if (e.key === "Escape") stageActor.send({ type: "BACK" });

      // Cmd+H — force home (idle)
      if (e.metaKey && e.key === "h") stageActor.send({ type: "HOME" });

      // Cmd+F — force fake mode (all subsequent tools play fallback MP4s)
      if (e.metaKey && e.key === "f") {
        stageActor.send({ type: "FORCE_FAKE" });
        console.log("[KILL] Fake mode forced");
      }

      // Cmd+B — master backup MP4 (catastrophic failure)
      if (e.metaKey && e.key === "b") {
        const video = document.createElement("video");
        video.src = "/fallback/master-backup.mp4";
        video.autoplay = true;
        video.className = "fixed inset-0 w-full h-full z-[9999] object-cover";
        document.body.appendChild(video);
      }

      // Cmd+R — reset XState to idle, restart demo
      if (e.metaKey && e.key === "r") {
        e.preventDefault(); // prevent browser refresh
        stageActor.send({ type: "RESET" });
      }

      // Cmd+T — toggle "type instead of speak" (bypass voice)
      if (e.metaKey && e.key === "t") {
        e.preventDefault();
        // Show a text input overlay for direct event entry
        toggleTypeMode();
      }

      // Cmd+M — mute Howler audio (if venue PA gets confused)
      if (e.metaKey && e.key === "m") {
        e.preventDefault();
        ambientBed.mute(!ambientBed.mute());
        sfx.mute(!sfx.mute());
      }
    };
    window.addEventListener("keydown", handler);
    return () => window.removeEventListener("keydown", handler);
  }, []);

  return null;
}
```

